# Copy this file to .env and replace the example values.
# Never commit .env or put real credentials in this file.

# PostgreSQL database password. Use letters and numbers only.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Random JWT signing secret; use at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Initial administrator account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=System Administrator

# Host port exposed by Docker Compose
APP_PORT=8080

# Optional AI-based incident classification.
# Leave empty to use local classification rules.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Development/demo data only. Keep disabled for normal use.
SEED_DEMO=false
DEMO_PASSWORD=change-me-demo
